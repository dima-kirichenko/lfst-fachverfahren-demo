# Echter Red Hat JBoss EAP 8.0 Server, provisioniert aus echten Red Hat
# Galleon Feature-Packs (oeffentliches Red Hat GA Maven-Repository).
# Kein JBoss-Image-Pull noetig: Der Server wird per eap-maven-plugin
# aus Feature-Packs zusammengestellt (Versionen geprueft ueber
# maven.repository.redhat.com, EAP 8.0.x Final, kein Beta).
# Das Laufzeit-Image basiert auf UBI 9 minimal VON registry.redhat.io
# (dafuer wird der Registry Service Account per podman login benutzt).

# Stage 1: EAP 8.0 Server provisionieren + WAR bauen (alles oeffentlich)
FROM registry.access.redhat.com/ubi9/openjdk-21:1.20 AS builder
USER root
WORKDIR /build
COPY pom.xml .
RUN mvn dependency:go-offline -B
COPY src ./src
RUN mvn -Peap clean package -DskipTests -B
# Diagnose: Wo liegt der provisionierte Server? (steht im Build-Log)
RUN echo "=== EAP PROVISIONING RESULT ===" && ls -la /build/target/ && test -d /build/target/server && echo "SERVER DIR OK: /build/target/server"

# Stage 2: Gehärtetes Laufzeit-Image auf UBI 9 minimal (Registry-Login noetig)
FROM registry.redhat.io/ubi9/ubi-minimal:latest

USER root

# Server aus dem Builder uebernehmen (numeric UID/GID: kein shadow-utils noetig,
# OpenShift-Arbitrary-UID-konform wie das k8s Deployment es verlangt)
COPY --from=builder --chown=10001:0 /build/target/server /opt/eap
RUN chmod -R g=u /opt/eap/standalone && rm -rf /opt/eap/standalone/configuration/standalone_xml_history

# JBoss-CLI-Haertung einspielen (Undertow-Header, Welcome-Content, DoS-Limits,
# Deployment-Scanner aus). Das Skript ist Undertow-generisch und gilt fuer
# WildFly wie JBoss EAP gleichermassen.
COPY --chown=10001:0 wildfly/harden-standalone.cli /opt/eap/bin/harden-standalone.cli
RUN /opt/eap/bin/jboss-cli.sh --file=/opt/eap/bin/harden-standalone.cli && \
    rm -f /opt/eap/bin/harden-standalone.cli

USER 10001:0

EXPOSE 8080 9990

ENV JAVA_OPTS="-XX:MaxRAMPercentage=75.0 -Djava.net.preferIPv4Stack=true -Djboss.bind.address=0.0.0.0 -Djboss.bind.address.management=0.0.0.0"

CMD ["/opt/eap/bin/standalone.sh", "-c", "standalone.xml"]
